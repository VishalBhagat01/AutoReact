# Backend Environment Variables
PORT=5000
NODE_ENV=development

# Figma API Personal Access Token
# Obtain from Figma Settings -> Account -> Personal access tokens
FIGMA_TOKEN=your_figma_personal_access_token_here

# MongoDB Connection URI (for persistence)
MONGODB_URI=mongodb://localhost:27017/reagmat

# Asset Storage Directory (local filesystem storage for extracted images/SVGs)
ASSET_STORAGE_DIR=./storage/assets

# Python AI Microservice (FastAPI) & Internal Shared Secret
PYTHON_SERVICE_URL=http://127.0.0.1:8000
PYTHON_SERVICE_SECRET=your_internal_service_secret
AI_SERVICE_URL=http://127.0.0.1:8000
